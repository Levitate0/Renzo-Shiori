<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep offline downloads running when the app is tabbed out -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- TV support. Both marked not-required so this stays a phone app that CAN
         run on a television, rather than two builds: leanback launchers need the
         feature declared, and a required touchscreen would hide the app from
         every TV in the Play catalogue. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Voice search on TV. Package-visibility filtering (API 30+) hides every
         other app unless it's declared here, so without this resolveActivity()
         returns null on any modern device and the mic affordance would never
         appear — even on TVs that DO have a recogniser. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".RenzoApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Renzo"
        android:banner="@drawable/renzo_login_banner"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:allowBackup="true">

        <!-- usesCleartextTraffic allows plain-http LAN addresses (e.g. http://192.168.x.x:8080),
             matching the Jellyfin app's behavior. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Same activity for phones and TVs — see ui/tv/TvFocus.kt for
                     why there is no separate TV screen tree. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RenzoDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
