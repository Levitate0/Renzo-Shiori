<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Platform theme, not AppCompat/Material-Components — the native-Compose
         rewrite drops appcompat entirely; MaterialTheme (Kotlin) owns all
         actual app theming, this XML theme only configures system chrome
         (splash screen, status/nav bar, window background) before Compose
         takes over. -->
    <style name="Theme.Renzo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>

        <!-- Android 12+ system splash. Without these it defaults to a white
             surround with the launcher-icon foreground doing the expand
             animation. Theme-adaptive via resource qualifiers: light =
             @color/splash_background (white) + grey torii, dark = the
             values-night override (#0A0A0A) + white torii (drawable-night).
             Icon-circle color matches the background so no disc shows behind. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/splash_background</item>
    </style>
</resources>
