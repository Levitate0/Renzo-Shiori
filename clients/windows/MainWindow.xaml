<Window x:Class="RensaioWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Rensaiō" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="#0a0a0a"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" DefaultBackgroundColor="#0A0A0A" />

        <Grid x:Name="ServerPanel" Background="#0a0a0a">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                <TextBlock Text="Rensaiō" FontSize="42" FontWeight="Bold" Foreground="#fafafa"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="Connect to your server" FontSize="14" Foreground="#a1a1aa"
                           HorizontalAlignment="Center" Margin="0,0,0,24" />
                <TextBox x:Name="AddressBox" FontSize="15" Padding="10,8"
                         Background="#18181b" Foreground="#fafafa" BorderBrush="#3f3f46"
                         CaretBrush="#fafafa" KeyDown="AddressBox_KeyDown" />
                <TextBlock Text="e.g. https://rensaio.example.com or http://192.168.1.10:8080"
                           FontSize="11" Foreground="#71717a" Margin="2,6,0,20" />
                <Button x:Name="ConnectButton" Content="Connect" FontSize="15" Padding="0,10"
                        Background="#fafafa" Foreground="#0a0a0a" BorderThickness="0"
                        Cursor="Hand" Click="ConnectButton_Click" />
                <TextBlock x:Name="ErrorText" Foreground="#ef4444" FontSize="13" TextWrapping="Wrap"
                           Margin="2,16,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Foreground="#a1a1aa" FontSize="13"
                           Margin="2,16,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
